#!/bin/sh
# JioFiber Subscriber Identity & WAN Configurator for JCOW407 & JCOW414

. /lib/functions.sh 2>/dev/null
. /lib/functions/system.sh 2>/dev/null

BOARD=$(board_name 2>/dev/null)

usage() {
    echo "Usage: $0 {status|native|clone <GPON_SN> <WAN_MAC> [PLOAM_PASS]}"
    echo ""
    echo "Commands:"
    echo "  status                            Show current GPON and WAN identity"
    echo "  native                            Use this router's own factory hardware credentials"
    echo "  clone <GPON_SN> <WAN_MAC> [PASS]  Use credentials from an active subscribed Jio router"
    echo ""
    echo "Example:"
    echo "  $0 clone SKYWXXXXXXXX AA:BB:CC:DD:EE:FF 00000001"
    echo "  $0 clone SCOMXXXXXXXX AA:BB:CC:DD:EE:FF 00000001"
    exit 1
}

normalize_mac() {
    echo "$1" | tr 'a-f' 'A-F' | sed 's/[:-]//g' | sed 's/\(..\)/\1:/g; s/:$//'
}

mac_to_clientid() {
    local hex
    hex=$(echo "$1" | tr 'A-F' 'a-f' | sed 's/[:-]//g')
    echo "01${hex}"
}

case "$1" in
    status)
        echo "=== xPON Configuration ==="
        uci -q show xpon.main
        echo ""
        echo "=== WAN Configuration ==="
        uci -q show network.wan
        ;;
    native)
        echo "[*] Setting native hardware credentials for board: ${BOARD:-generic}..."
        case "$BOARD" in
            jiofiber,jcow407)
                uci set xpon.main.vendor_id='SKYW'
                uci set xpon.main.equipment_id='ECONET'
                uci set xpon.main.hardware_version='RP0101'
                uci set xpon.main.software_version_0='SKYWTF1_JCOW407_R2.42'
                uci set xpon.main.software_version_1='SKYWTF1_JCOW407_R2.42'
                ;;
            *)
                uci set xpon.main.vendor_id='SCOM'
                uci set xpon.main.equipment_id='ECONET'
                uci set xpon.main.hardware_version='RP0201'
                uci set xpon.main.software_version_0='JCOW414_R2.59'
                uci set xpon.main.software_version_1='JCOW414_R2.59'
                ;;
        esac
        uci set xpon.main.traffic_management_option='2'
        uci -q delete xpon.main.serial
        uci -q delete xpon.main.password
        uci commit xpon

        uci -q delete network.wan.macaddr
        uci -q delete network.wan.vendorid
        uci -q delete network.wan.clientid
        uci set network.wan.hostname='*'
        uci commit network

        echo "[✓] Configured for native hardware identity. Reloading network and xpon..."
        /etc/init.d/network restart
        ;;
    clone)
        [ -z "$2" ] || [ -z "$3" ] && usage
        SN="$2"
        RAW_MAC="$3"
        PASS="${4:-00000001}"

        MAC=$(normalize_mac "$RAW_MAC")
        CLIENT_ID=$(mac_to_clientid "$RAW_MAC")
        VENDOR_ID=$(echo "$SN" | cut -c1-4)

        case "$VENDOR_ID" in
            SKYW)
                HW_VER='RP0101'
                SW_VER='SKYWTF1_JCOW407_R2.42'
                ;;
            *)
                VENDOR_ID='SCOM'
                HW_VER='RP0201'
                SW_VER='JCOW414_R2.59'
                ;;
        esac

        echo "[*] Configuring subscribed identity:"
        echo "    GPON SN:    $SN"
        echo "    Vendor ID:  $VENDOR_ID"
        echo "    WAN MAC:    $MAC"
        echo "    Option 60:  $MAC"
        echo "    Option 61:  $CLIENT_ID"
        echo "    Password:   $PASS"

        # 1. xPON OMCI Profile
        uci set xpon.main.enabled='1'
        uci set xpon.main.netdev='pon0'
        uci set xpon.main.vendor_id="$VENDOR_ID"
        uci set xpon.main.equipment_id='ECONET'
        uci set xpon.main.hardware_version="$HW_VER"
        uci set xpon.main.software_version_0="$SW_VER"
        uci set xpon.main.software_version_1="$SW_VER"
        uci set xpon.main.traffic_management_option='2'
        uci set xpon.main.serial="$SN"
        uci set xpon.main.password="$PASS"
        uci commit xpon

        # 2. WAN Interface (VLAN 1015, DHCP options)
        uci set network.wan=interface
        uci set network.wan.device='pon0.1015'
        uci set network.wan.proto='dhcp'
        uci set network.wan.hostname='*'
        uci set network.wan.metric='10'
        uci set network.wan.macaddr="$MAC"
        uci set network.wan.vendorid="$MAC"
        uci set network.wan.clientid="$CLIENT_ID"
        uci commit network

        echo "[✓] Applied! Reloading network and xpon..."
        /etc/init.d/network restart
        ;;
    *)
        usage
        ;;
esac
